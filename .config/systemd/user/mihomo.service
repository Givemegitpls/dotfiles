[Unit]
Description=Mihomo daemon
After=network.target NetworkManager.service systemd-networkd.service iwd.service

[Service]
Type=simple
LimitNPROC=500
LimitNOFILE=1000000
Restart=always
RestartSec=5
ExecStart=/usr/bin/sudo /usr/bin/mihomo -f %h/.config/mihomo/config.yml

[Install]
WantedBy=default.target
