{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "disabled": true
    },
    "python": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ],
      "initialization": {
        "settings": {
          "basedpyright": {
            "analysis": {
              "typeCheckingMode": "strict",
              "diagnosticMode": "workspace"
            }
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 5,
    "prune": true
  },
  "agent": {
    "build": {
      "prompt": "{file:./prompts/build.md}",
      "permission": {
        "edit": "allow",
        "read": {
          "**/.env": "ask",
          "**/.env.*": "ask",
          "*": "allow"
        },
        "external_directory": {
          "*": "ask",
          "~/.local/share/opencode/memory/**": "allow",
          "~/.config/opencode/skills/**": "allow"
        },
        "bash": {
          "*": "ask",
          "git *": "deny",
          "git diff*": "allow",
          "git show*": "allow",
          "git log*": "allow",
          "git ls-tree*": "allow",
          "git merge-base*": "allow",
          "git reflog*": "allow",
          "git status*": "allow",
          "git blame*": "allow",
          "git rev-parse*": "allow",
          "git describe*": "allow",
          "git remote -v*": "allow",
          "git config --get*": "allow",
          "git branch --show-current": "allow",
          "head *": "allow",
          "tail *": "allow",
          "fd *": "allow",
          "rg *": "allow",
          "sudo*": "deny",
          "pip*": "deny"
        }
      }
    },
    "plan": {
      "description": "Analyzes code and proposes plans without making changes; hands execution off to build.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "read": {
          "**/.env": "ask",
          "**/.env.*": "ask",
          "*": "allow"
        },
        "external_directory": {
          "*": "ask",
          "~/.config/opencode/skills/**": "allow"
        },
        "bash": {
          "*": "ask",
          "git *": "deny",
          "git diff*": "allow",
          "git show*": "allow",
          "git log*": "allow",
          "git ls-tree*": "allow",
          "git merge-base*": "allow",
          "git reflog*": "allow",
          "git status*": "allow",
          "git blame*": "allow",
          "git rev-parse*": "allow",
          "git describe*": "allow",
          "git remote -v*": "allow",
          "git config --get*": "allow",
          "git branch --show-current": "allow",
          "head *": "allow",
          "tail *": "allow",
          "fd *": "allow",
          "rg *": "allow",
          "sudo*": "deny",
          "pip*": "deny"
        }
      }
    },
    "explore": {
      "permission": {
        "edit": "deny",
        "read": {
          "**/.env": "ask",
          "**/.env.*": "ask",
          "*": "allow"
        },
        "external_directory": "ask",
        "bash": "deny"
      }
    },
    "general": {
      "permission": {
        "edit": {
          "~/.local/share/opencode/memory/**": "allow",
          "~/.config/opencode/skills/**": "allow",
          "*": "ask"
        },
        "read": {
          "**/.env": "ask",
          "**/.env.*": "ask",
          "*": "allow"
        },
        "external_directory": {
          "*": "ask",
          "~/.local/share/opencode/memory/**": "allow",
          "~/.config/opencode/skills/**": "allow"
        },
        "bash": {
          "*": "ask",
          "git *": "deny",
          "git diff*": "allow",
          "git show*": "allow",
          "git log*": "allow",
          "git ls-tree*": "allow",
          "git merge-base*": "allow",
          "git reflog*": "allow",
          "git status*": "allow",
          "git blame*": "allow",
          "git rev-parse*": "allow",
          "git describe*": "allow",
          "git remote -v*": "allow",
          "git config --get*": "allow",
          "git branch --show-current": "allow",
          "head *": "allow",
          "tail *": "allow",
          "fd *": "allow",
          "rg *": "allow",
          "sudo*": "deny",
          "pip*": "deny"
        }
      }
    },
    "title": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "summary": {
      "permission": {
        "edit": "deny",
        "bash": {
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git rebase*": "deny",
          "git cherry-pick*": "deny",
          "git revert*": "deny",
          "sudo*": "deny",
          "*": "deny",
          "pip*": "deny"
        }
      }
    },
    "compaction": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
