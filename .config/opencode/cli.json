{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato-transparent"
  },
  "keybinds": {
    "app.exit": "ctrl+q,ctrl+d",
    "session.interrupt": "ctrl+c"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true,
  "attention": {
    "notifications": true
  }
}
