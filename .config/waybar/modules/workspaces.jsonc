{
  "group/workspaces-group": {
    "orientation": "horizontal",
    "modules": ["mango/workspaces"],
  },
  "mango/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "hide-empty": true,
    "format-icons": {
      "active": "",
      "default": "",
      "urgent": "󰗖",
    },
  },
}
