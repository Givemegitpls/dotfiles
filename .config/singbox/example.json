{
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-remote",
        "detour": "proxy",
        "server": "8.8.8.8"
      },
      {
        "type": "local",
        "tag": "dns-direct",
        "detour": "direct"
      }
    ],
    "rules": [
      {
        "rule_set": "geoip-ru",
        "server": "dns-direct"
      }
    ]
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "users": [
        {
          "Username": "changeme",
          "Password": "changeme"
        }
      ]
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-box",
      "mtu": 1500,
      "address": "172.19.0.1/24",
      "auto_route": true,
      "strict_route": true,
      "stack": "gvisor",
      "endpoint_independent_nat": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "vless",
      "tag": "vless",
      "domain_resolver": {
        "server": "dns-direct",
        "strategy": "prefer_ipv4"
      },
      "server": "changeme",
      "server_port": 443,
      "uuid": "changeme",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "changeme",
        "fragment": true,
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "changeme",
          "short_id": "changeme"
        }
      }
    },
    {
      "type": "naive",
      "tag": "naive",
      "server": "changeme",
      "server_port": 443,
      "username": "changeme",
      "password": "changeme",
      "udp_over_tcp": true,
      "tls": {
        "enabled": true,
        "server_name": "changeme"
      }
    },
    {
      "type": "urltest",
      "tag": "proxy",
      "outbounds": ["vless", "naive"],
      "url": "http://cp.cloudflare.com",
      "interval": "2m0s",
      "tolerance": 50
    }
  ],
  "route": {
    "rules": [
      {
        "network": "udp",
        "port": 53,
        "outbound": "direct"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "inbound": "tun-in",
        "action": "sniff",
        "timeout": "1s"
      },
      {
        "inbound": "tun-in",
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "inbound": "mixed-in",
        "action": "sniff",
        "timeout": "1s"
      },
      {
        "inbound": "mixed-in",
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "domain_suffix": ["ru", "xn--p1ai", "su"],
        "rule_set": "geoip-ru",
        "outbound": "direct"
      },
      {
        "process_name": [
          "pacman",
          "yay",
          "makepkg",
          "reflector",
          "electron",
          "neovim",
          "git",
          "chrome",
          "chromium",
          "firefox",
          "Telegram",
          "wget",
          "lowfi",
          "opencode"
        ],
        "outbound": "proxy"
      }
    ],
    "rule_set": [
      {
        "type": "local",
        "tag": "geoip-ru",
        "path": ".config/singbox/geoip/geoip-ru.srs"
      }
    ],
    "final": "direct",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "prefer_ipv4"
    }
  }
}
