#!/usr/bin/env python3
from __future__ import annotations

import asyncio
import os
import subprocess
import sys
from dataclasses import dataclass
from typing import final


def print(message: str) -> None:
    _ = sys.stdout.write(message + "\n")
    _ = sys.stdout.flush()


@dataclass
class Session:
    start_command: str
    stop_command: str


@final
class Gamescope(Session):
    start_command: str = "gamescope --mangoapp -e -- steam -steamdeck -steamos3"
    stop_command: str = "steam -shutdown"


@final
class UWSM(Session):
    start_command: str = "uwsm start default"
    stop_command: str = "uwsm stop"


class Daemon:
    def __init__(self, service_name: str) -> None:
        self.service_name: str = service_name
        self.socket_path: str = f"/tmp/{service_name}.sock"
        self.current_session: str | None = None
        self.process: asyncio.subprocess.Process | None = None
        self._server: asyncio.AbstractServer | None = None
        self._monitor_task: asyncio.Task[None] | None = None

    async def start(self):
        try:
            os.unlink(self.socket_path)
        except FileNotFoundError:
            pass
        try:
            with open("/proc/self/comm", "w") as f:
                _ = f.write(self.service_name)
        except OSError:
            pass
        self._server = await asyncio.start_unix_server(
            self.handle_client, self.socket_path
        )
        await self.switch_to("uwsm")
        async with self._server:
            await self._server.serve_forever()

    async def handle_client(
        self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter
    ):
        try:
            data = (await reader.read(1024)).decode().strip()
            if data == "gamescope":
                await self.switch_to("gamescope")
            elif data == "uwsm":
                await self.switch_to("uwsm")
            elif data == "status":
                response = self.current_session or "none"
                writer.write(response.encode())
                await writer.drain()
                writer.close()
                return
            elif data == "stop":
                await self.stop_current()
            else:
                _ = sys.stderr.write(f"Unknown command: {data}\n")
        except Exception as e:
            _ = sys.stderr.write(f"Error: {e}\n")
        writer.write(b"OK")
        await writer.drain()
        writer.close()

    async def switch_to(self, name: str):
        if name == self.current_session:
            return
        await self.stop_current()
        session_cls = Gamescope if name == "gamescope" else UWSM
        self.process = await asyncio.create_subprocess_shell(
            session_cls.start_command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        self.current_session = name
        self._monitor_task = asyncio.create_task(self._monitor_process())

    async def _monitor_process(self) -> None:
        assert self.process is not None
        try:
            _ = await self.process.wait()
        except asyncio.CancelledError:
            return
        _ = sys.stderr.write(
            f"Session {self.current_session} exited with code {self.process.returncode}\n"
        )
        if self._server:
            self._server.close()

    async def stop_current(self):
        if self.current_session is None:
            return
        if self._monitor_task:
            _ = self._monitor_task.cancel()
            self._monitor_task = None
        try:
            stop_cmd = (
                Gamescope.stop_command
                if self.current_session == "gamescope"
                else UWSM.stop_command
            )
            _ = await asyncio.create_subprocess_shell(
                stop_cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except Exception as e:
            _ = sys.stderr.write(f"Error running stop command: {e}\n")
        if self.process and self.process.returncode is None:
            self.process.terminate()
            try:
                _ = await asyncio.wait_for(self.process.wait(), timeout=5)
            except asyncio.TimeoutError:
                self.process.kill()
                _ = await self.process.wait()
        self.current_session = None
        self.process = None


async def send_command(command: str, service_name: str):
    try:
        reader, writer = await asyncio.open_unix_connection(f"/tmp/{service_name}.sock")
        writer.write(command.encode())
        await writer.drain()
        response = (await reader.read(1024)).decode()
        print(response)
        writer.close()
    except (FileNotFoundError, ConnectionRefusedError):
        _ = sys.stderr.write("Daemon not running\n")
        sys.exit(1)


if __name__ == "__main__":
    service_name = "steamui_switcher"
    if len(sys.argv) == 2 and sys.argv[1] in (
        "gamescope",
        "uwsm",
        "status",
        "stop",
    ):
        asyncio.run(send_command(sys.argv[1], service_name))
    elif subprocess.run(["pgrep", service_name], capture_output=True).returncode != 0:
        asyncio.run(Daemon(service_name).start())
    else:
        print("Usage: steamui_switcher.py gamescope|uwsm|status|stop")
        sys.exit(1)
