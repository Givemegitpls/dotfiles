#!/usr/bin/env python3
from enum import StrEnum
import json
import os
import subprocess
from sys import stdout
from time import sleep
from typing import Any


class Direction(StrEnum):
    right = "--right-of"
    left = "--left-of"
    above = "--above"
    below = "--below"


def main(config_path: str):
    settings: Any = {}
    monitors: dict[str, str] = {}
    query_for_queue: dict[str, list[str]] = {}
    while True:
        if os.path.exists(config_path):
            with open(config_path) as f:
                settings_on_disc = json.load(f)
        else:
            settings_on_disc: Any = {}

        current_monitors: dict[str, str] = {}
        for mon in json.loads(subprocess.check_output(("wlr-randr", "--json"))):
            current_monitors[mon["description"]] = mon["name"]

        definite_monitors: dict[str, str] = settings_on_disc.get("monitors", {})
        manual_positioned: list[str] = [
            desc for desc in definite_monitors.values() if "--pos" in desc
        ]
        queue: list[str] = []
        for desc, query in definite_monitors.items():
            if (not (Direction.right in query or Direction.left in query)) and (
                desc not in manual_positioned
            ):
                continue
            splitted_query: list[str] = query.split(" ")
            if Direction.left in query:
                direction = Direction.left
                index_offset = 0
            else:
                index_offset = +1
                direction = Direction.right
            master = splitted_query[splitted_query.index(direction) + 1]
            slave = current_monitors.get(desc)
            if slave and (master in list(current_monitors.values())):
                if master not in queue:
                    queue.append(master)
                if slave not in queue:
                    queue.insert(queue.index(master) + index_offset, slave)
                splitted_query.remove(direction)
                splitted_query.remove(master)
                query_for_queue[slave] = splitted_query
        if settings == settings_on_disc and monitors == current_monitors:
            if ("rescan-time" in settings) and (settings.get("rescan-time") is None):
                break
            else:
                sleep(settings.get("rescan-time", 5))
                continue
        monitors = current_monitors
        reversed: bool = Direction.left == getattr(
            Direction, settings.get("default-direction", "right")
        )
        settings = settings_on_disc
        setuped: list[str] = []
        for desc in sorted(monitors.keys(), reverse=reversed):
            name = monitors[desc]
            if desc in definite_monitors and name not in queue:
                subprocess.run(
                    (
                        "wlr-randr",
                        "--output",
                        name,
                        *definite_monitors[desc].split(" "),
                    )
                )
                setuped.append(name)
            else:
                if name not in queue:
                    queue.append(name)

        process: list[list[str]] = [
            [
                "--output",
                queue[0],
                "--pos",
                "0,0",
                *query_for_queue.get(queue[0], []),
            ]
        ]
        for mon in queue[1::]:
            process.append(
                [
                    "--output",
                    mon,
                    str(Direction.right),
                    queue[queue.index(mon) - 1],
                    *query_for_queue.get(mon, ""),
                ]
            )
            setuped.append(mon)
        for query in process:
            subprocess.run(["wlr-randr"] + query)
        stdout.write(
            " ".join(["wlr-randr"] + [" ".join(query) for query in process] + ["\n"])
        )
        stdout.flush()


if __name__ == "__main__":
    service_name = "waymonman"

    home = os.getenv("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
    config_path = "/".join(
        (
            home,
            service_name,
            "config.json",
        )
    )
    with open("/proc/self/comm", "w") as f:
        f.write(service_name)
    main(config_path)
