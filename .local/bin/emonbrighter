#!/bin/bash

msgId="3378455"

icons_path=$HOME/.local/share/icons

case "$1" in
"up")
  brightnessctl --class='backlight' set 5%+
  ;;
"down")
  brightnessctl --class='backlight' set 5%-
  ;;
esac

brightpercent=$(brightnessctl -m --class='backlight' | awk -F, '{print substr($4, 0, length($4)-1)}')

if (($brightpercent > 75)); then
  icon=$icons_path/brightness-highest.svg
elif (($brightpercent > 50)); then
  icon=$icons_path/brightness-high.svg
elif (($brightpercent > 25)); then
  icon=$icons_path/brightness-medium.svg
else
  icon=$icons_path/brightness-low.svg
fi

notify-send -i $icon -a "changeBrightness" -u low -r "$msgId" \
  -h int:value:"$brightpercent" "Яркость экрана: $brightpercent%"
