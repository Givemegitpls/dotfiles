#!/usr/bin/python
import os
from random import randrange
import subprocess
import re
import sys

swww_output = subprocess.check_output(["swww", "query"]).decode("utf-8")
if not (path := re.search(r"(?<=image: ).*$", swww_output)):
    sys.exit(1)
path = path[0]
current = path.split("/")
current = current[len(current) - 1]

images = os.listdir(path.replace(current, ""))

next = images.index(current) + 1

if next >= len(images):
    next = images[0]
else:
    next = images[next]

next = path.replace(current, next)

swww_command = f"swww img {next} --transition-step 90 --transition-angle 45 --transition-type outer --transition-fps 60 --transition-pos {float(randrange(1, 9, 1)) / 10},{float(randrange(0, 10, 1)) / 10}"


subprocess.run(swww_command.split(" "))
