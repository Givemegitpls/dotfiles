#!/usr/bin/python
import os
import re
import subprocess
import sys
from random import randrange

awww_output = subprocess.check_output(("awww", "query")).decode("utf-8")
if not (path := re.search(r"(?<=image: ).*$", awww_output)):
    sys.exit(1)
path = path[0]
current = path.split("/")
current = current[len(current) - 1]

images = os.listdir(path.replace(current, ""))

next = images.index(current) + 1

if next >= len(images):
    next = images[0]
else:
    next = images[next]

next = path.replace(current, next)

subprocess.run(
    [
        "awww",
        "img",
        next,
        "--transition-step",
        "90",
        "--transition-angle",
        "45",
        "--transition-type",
        "outer",
        "--transition-fps",
        "60",
        "--transition-pos",
        ",".join(
            (
                str((float(randrange(1, 9, 1)) / 10)),
                str(float(randrange(0, 10, 1)) / 10),
            )
        ),
    ],
    check=False,
)
